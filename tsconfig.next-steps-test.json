{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2022", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": ".tmp/next-steps-test",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "src/app/api/steps/route.ts",
    "src/lib/next-steps.ts",
    "src/lib/next-steps-types.ts",
    "src/lib/next-steps-validation.ts",
    "src/lib/next-steps/handler.ts",
    "src/lib/next-steps/next-steps.test.ts",
    "src/types/outcomes.ts",
    "src/types/user.ts",
    "src/data/education-steps.json"
  ]
}
